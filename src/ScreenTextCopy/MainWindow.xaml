<Window x:Class="ScreenTextCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenTextCopy.Localization"
        xmlns:conv="clr-namespace:ScreenTextCopy.Converters"
        Title="ScreenTextCopy"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FlowDirection="{Binding Loc.FlowDirection}"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrToVis" />
        <conv:InverseBoolConverter x:Key="InvBool" />
    </Window.Resources>

    <Grid>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="/Assets/logo.png" Width="40" Height="40"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc app.title}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{loc:Loc app.tagline}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenSettingsCommand}"
                    Content="{loc:Loc action.settings}" VerticalAlignment="Center" />
        </Grid>

        <!-- ACTION BAR -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CaptureCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                        Content="{loc:Loc action.capture}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Text="{loc:Loc action.capture.hint}" />
                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                            Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc action.shortcut}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding HotkeyDisplay}" Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold" FlowDirection="LeftToRight"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ComboBox Grid.Column="2" Style="{StaticResource AppComboBox}"
                          Width="150" Margin="0,0,8,0"
                          ItemsSource="{Binding TranslateTargets}"
                          SelectedItem="{Binding SelectedTranslateTarget}"
                          DisplayMemberPath="NativeName"
                          IsEnabled="{Binding HasResult}" />

                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding TranslateCommand}"
                        IsEnabled="{Binding HasResult}"
                        Content="{loc:Loc action.translate}" />

                <Button Grid.Column="4" Style="{StaticResource AccentButton}"
                        Command="{Binding SendToMobileCommand}"
                        IsEnabled="{Binding HasResult}"
                        Content="{loc:Loc action.sendToMobile}" />
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Recognized text -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc app.title}" Style="{StaticResource SubtitleText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyCommand}"
                                    IsEnabled="{Binding HasResult}"
                                    Content="{loc:Loc action.copy}" />
                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearCommand}"
                                    IsEnabled="{Binding HasResult}"
                                    Content="{loc:Loc action.clear}" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" Style="{StaticResource ResultTextBox}"
                             Text="{Binding RecognizedText, UpdateSourceTrigger=PropertyChanged}"
                             FlowDirection="{Binding RecognizedText, Converter={x:Static conv:TextToFlowDirectionConverter.Instance}}"
                             TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc result.characters}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text=": " Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding CharacterCount}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc result.words}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text=": " Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding WordCount}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}"
                                Visibility="{Binding Confidence, Converter={StaticResource StrToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc result.confidence}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text=": " Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Confidence}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="%" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="16" Background="Transparent"
                          HorizontalAlignment="Center" />

            <!-- Translation -->
            <Border Grid.Column="2" Style="{StaticResource Card}"
                    Visibility="{Binding ShowTranslation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc translate.result}" Style="{StaticResource SubtitleText}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                Command="{Binding CopyTranslationCommand}"
                                Content="{loc:Loc action.copy}" />
                    </Grid>
                    <TextBox Grid.Row="1" Style="{StaticResource ResultTextBox}"
                             IsReadOnly="True"
                             FlowDirection="{Binding TranslatedText, Converter={x:Static conv:TextToFlowDirectionConverter.Instance}}"
                             Text="{Binding TranslatedText, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Style="{StaticResource Pill}" Margin="0,16,0,0"
                HorizontalAlignment="Left" Background="{DynamicResource SurfaceAltBrush}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
                <TextBlock Text="  ·  " Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Run Text="{loc:Loc status.ocrTime}" /><Run Text=" " /><Run Text="{Binding ElapsedMs, Mode=OneWay}" /><Run Text=" ms" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

        <!-- COPY / STATUS TOAST (overlays everything, bottom-center) -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,32" Padding="18,11" CornerRadius="12"
                IsHitTestVisible="False"
                FlowDirection="{Binding Loc.FlowDirection}"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
                        </DataTrigger>
                        <!-- Fade + rise each time the toast becomes visible. -->
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="12" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.28"
                                  Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>
            <TextBlock Text="{Binding ToastText}" Style="{StaticResource BodyText}"
                       FontWeight="Medium" VerticalAlignment="Center" TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
