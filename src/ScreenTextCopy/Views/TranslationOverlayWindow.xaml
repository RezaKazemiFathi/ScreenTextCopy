<Window x:Class="ScreenTextCopy.Views.TranslationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenTextCopy.Localization"
        xmlns:conv="clr-namespace:ScreenTextCopy.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        FontFamily="{StaticResource AppFontFamily}"
        Width="440"
        MinHeight="80">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InvBool" />
    </Window.Resources>

    <Border CornerRadius="14" Padding="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45"
                              Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Drag handle / header -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="14,14,0,0" Padding="14,9" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding HeaderText}"
                               Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Padding="8,3"
                                Command="{Binding RetryCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                Content="{loc:Loc action.retry}"
                                ToolTip="{loc:Loc overlay.retry.hint}" />
                        <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="4,0,0,0"
                                Click="OnCopyClick"
                                Content="{loc:Loc action.copy}" />
                        <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="4,0,0,0"
                                Click="OnCloseClick" Content="✕" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Translated text (the important part for game/movie mode) -->
            <TextBox Grid.Row="1" Margin="14,12,14,6"
                     Background="Transparent" BorderThickness="0"
                     IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="260" VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="16"
                     FlowDirection="{Binding TranslatedText, Converter={x:Static conv:TextToFlowDirectionConverter.Instance}}"
                     Text="{Binding TranslatedText, Mode=OneWay}" />

            <!-- Original (collapsible, muted) -->
            <StackPanel Grid.Row="2" Margin="14,0,14,12"
                        Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVis}}">
                <Separator Margin="0,2,0,6" Background="{DynamicResource BorderBrush}" />
                <TextBlock Text="{loc:Loc overlay.original}" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,2" />
                <TextBox Background="Transparent" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="13"
                         FlowDirection="{Binding RecognizedText, Converter={x:Static conv:TextToFlowDirectionConverter.Instance}}"
                         Text="{Binding RecognizedText, Mode=OneWay}" />
            </StackPanel>

            <!-- Error banner: the real failure reason + a hint to retry (Ctrl+Shift+Z) -->
            <Border Grid.Row="3" Margin="14,0,14,12" Padding="10,8" CornerRadius="8"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource DestructiveBrush}" BorderThickness="1"
                    Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" />
                    <TextBlock Text="{loc:Loc overlay.retry.hint}" Style="{StaticResource CaptionText}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
