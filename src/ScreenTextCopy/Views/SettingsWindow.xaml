<Window x:Class="ScreenTextCopy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenTextCopy.Localization"
        xmlns:conv="clr-namespace:ScreenTextCopy.Converters"
        Title="{loc:Loc settings.title}"
        Width="620" Height="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FlowDirection="{Binding Loc.FlowDirection}"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InvBool" />
        <conv:FractionToPercentConverter x:Key="Percent" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc settings.title}"
                   Style="{StaticResource TitleText}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- APPEARANCE -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.appearance}" Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource CaptionText}" />
                        <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,12"
                                  ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                        <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource CaptionText}" />
                        <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                  ItemsSource="{Binding UiLanguages}"
                                  SelectedItem="{Binding SelectedUiLanguage}"
                                  DisplayMemberPath="NativeName" />
                    </StackPanel>
                </Border>

                <!-- OCR -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.ocr}" Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Loc settings.ocrLanguages.hint}"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding OcrLanguages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsInstalled}" />
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Command="{Binding InstallCommand}"
                                                Content="{loc:Loc action.install}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                        <!-- Live download progress: bar + percentage while installing. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Width="150"
                                                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Style="{StaticResource AppProgressBar}"
                                                         Width="96" VerticalAlignment="Center"
                                                         FlowDirection="LeftToRight"
                                                         Value="{Binding Progress}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="8,0,0,0"
                                                       MinWidth="34" VerticalAlignment="Center"
                                                       FlowDirection="LeftToRight"
                                                       Text="{Binding Progress, Converter={StaticResource Percent}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,10,0,0"
                                  Content="{loc:Loc settings.preprocess}"
                                  IsChecked="{Binding PreprocessImage}" />
                    </StackPanel>
                </Border>

                <!-- BEHAVIOR -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.behavior}" Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,0,0,8"
                                  Content="{loc:Loc settings.autoCopy}" IsChecked="{Binding AutoCopy}" />
                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,0,0,8"
                                  Content="{loc:Loc settings.minimizeToTray}"
                                  IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,0,0,8"
                                  Content="{loc:Loc settings.autoTranslate}"
                                  IsChecked="{Binding AutoTranslate}" />
                        <ComboBox Style="{StaticResource AppComboBox}"
                                  IsEnabled="{Binding AutoTranslate}"
                                  ItemsSource="{Binding TranslateTargets}"
                                  SelectedItem="{Binding AutoTranslateTarget}"
                                  DisplayMemberPath="NativeName" />
                    </StackPanel>
                </Border>

                <!-- GLOBAL SHORTCUT -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.hotkey}" Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Loc settings.hotkey.hint}"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Pill}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    HorizontalAlignment="Left" Padding="14,8">
                                <TextBlock Text="{Binding HotkeyEditor.Display}" Style="{StaticResource BodyText}"
                                           FontWeight="Medium" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" x:Name="HotkeyCaptureButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="capture"
                                    PreviewKeyDown="OnHotkeyCaptureKeyDown"
                                    LostFocus="OnHotkeyCaptureLostFocus"
                                    Click="OnHotkeyCaptureClick">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc settings.hotkey.rebind}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotkeyEditor.IsCapturing}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc settings.hotkey.press}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <!-- IN-PLACE OVERLAY SHORTCUT (game/movie mode) -->
                        <TextBlock Text="{loc:Loc settings.overlayHotkey}" Style="{StaticResource SubtitleText}"
                                   Margin="0,16,0,6" />
                        <TextBlock Text="{loc:Loc settings.overlayHotkey.hint}"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Pill}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    HorizontalAlignment="Left" Padding="14,8">
                                <TextBlock Text="{Binding OverlayHotkeyEditor.Display}" Style="{StaticResource BodyText}"
                                           FontWeight="Medium" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" x:Name="OverlayHotkeyCaptureButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="overlay"
                                    PreviewKeyDown="OnHotkeyCaptureKeyDown"
                                    LostFocus="OnHotkeyCaptureLostFocus"
                                    Click="OnHotkeyCaptureClick">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc settings.hotkey.rebind}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverlayHotkeyEditor.IsCapturing}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc settings.hotkey.press}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TRANSLATION -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.translation}" Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Loc settings.provider}" Style="{StaticResource CaptionText}" />
                        <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,12"
                                  SelectedIndex="{Binding Provider, Converter={x:Static conv:EnumIndexConverter.Instance}}">
                            <ComboBoxItem Content="{loc:Loc settings.provider.free}" />
                            <ComboBoxItem Content="{loc:Loc settings.provider.custom}" />
                        </ComboBox>
                        <StackPanel Visibility="{Binding IsCustomAi, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc settings.baseUrl}" Style="{StaticResource CaptionText}" />
                            <TextBox Style="{StaticResource LtrTextBox}" Margin="0,4,0,4"
                                     Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc settings.baseUrl.hint}" Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Loc settings.apiKey}" Style="{StaticResource CaptionText}" />
                            <TextBox Style="{StaticResource LtrTextBox}" Margin="0,4,0,4"
                                     Text="{Binding AiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc settings.apiKey.hint}" Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Loc settings.model}" Style="{StaticResource CaptionText}" />
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource AppComboBox}"
                                          x:Name="ModelComboBox"
                                          IsEditable="True"
                                          FlowDirection="LeftToRight"
                                          ItemsSource="{Binding AvailableModels}"
                                          SelectionChanged="OnModelSelectionChanged"
                                          Text="{Binding AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding RefreshModelsCommand}"
                                        IsEnabled="{Binding IsProbing, Converter={StaticResource InvBool}}"
                                        Content="{loc:Loc settings.refreshModels}" />
                            </Grid>
                            <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                                      Content="{loc:Loc settings.modelFailover}"
                                      IsChecked="{Binding AiModelFailover}" />

                            <!-- Connection test + live status -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding IsProbing, Converter={StaticResource InvBool}}"
                                        Content="{loc:Loc settings.testConnection}" />
                                <Border VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding ConnectionChecked, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource DestructiveBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- NETWORK / PROXY (applies to all outbound requests) -->
                        <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{loc:Loc settings.network}" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Loc settings.proxy}" Style="{StaticResource CaptionText}" />
                        <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                  SelectedIndex="{Binding ProxyMode, Converter={x:Static conv:EnumIndexConverter.Instance}}">
                            <ComboBoxItem Content="{loc:Loc settings.proxy.system}" />
                            <ComboBoxItem Content="{loc:Loc settings.proxy.none}" />
                            <ComboBoxItem Content="{loc:Loc settings.proxy.manual}" />
                        </ComboBox>
                        <StackPanel Visibility="{Binding IsManualProxy, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource LtrTextBox}" Margin="0,8,0,4"
                                     Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc settings.proxyAddress.hint}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute"
                                      Opacity="0.10">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="{DynamicResource PrimaryBrush}"
                                                 Geometry="M0,0 L2,0 L2,2 L0,2 Z M13,13 L15,13 L15,15 L13,15 Z" />
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.about}" Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc settings.about.creator}" Style="{StaticResource TitleText}"
                                           FontSize="17" />
                                <TextBlock Text="{loc:Loc settings.about.role}" Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,14" />
                            </StackPanel>
                            <!-- Iran flag (tricolour with emblem stripe) -->
                            <Border Grid.Column="1" Width="42" Height="28" CornerRadius="4"
                                    VerticalAlignment="Top" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    ToolTip="Iran">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Fill="#239F40" />
                                    <Rectangle Grid.Row="1" Fill="#FFFFFF" />
                                    <Rectangle Grid.Row="2" Fill="#DA0000" />
                                    <TextBlock Grid.Row="1" Text="﷼" FontSize="9"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#DA0000" FlowDirection="LeftToRight" />
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SocialButton}" Margin="0,0,10,0"
                                    Tag="https://github.com/rezakazemifathi"
                                    Click="OnOpenLink"
                                    ToolTip="https://github.com/rezakazemifathi">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Stretch="Uniform"
                                          Fill="{DynamicResource TextPrimaryBrush}"
                                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
                                    <TextBlock Text="{loc:Loc settings.about.github}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Style="{StaticResource BodyText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SocialButton}" Margin="0,0,10,0"
                                    Tag="https://instagram.com/rkfcode"
                                    Click="OnOpenLink"
                                    ToolTip="https://instagram.com/rkfcode">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Stretch="Uniform"
                                          Fill="{DynamicResource TextPrimaryBrush}"
                                          Data="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12.66.66 1.33 1.08 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.12-1.38.66-.66 1.08-1.33 1.38-2.12.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.38-2.12A5.87 5.87 0 0019.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zM12 16a4 4 0 110-8 4 4 0 010 8zm6.41-10.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z" />
                                    <TextBlock Text="{loc:Loc settings.about.instagram}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Style="{StaticResource BodyText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SocialButton}"
                                    Tag="https://youtube.com/rkfcode"
                                    Click="OnOpenLink"
                                    ToolTip="https://youtube.com/rkfcode">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Stretch="Uniform"
                                          Fill="{DynamicResource TextPrimaryBrush}"
                                          Data="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 00.5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 002.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 002.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z" />
                                    <TextBlock Text="{loc:Loc settings.about.youtube}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Style="{StaticResource BodyText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- SUPPORT / DONATE -->
                        <TextBlock Text="{loc:Loc settings.support}" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Margin="0,0,10,0"
                                    Tag="https://daramet.com/RKFi"
                                    Click="OnOpenLink"
                                    ToolTip="https://daramet.com/RKFi">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="﷼" FontSize="15" VerticalAlignment="Center"
                                               FlowDirection="LeftToRight"
                                               Foreground="{DynamicResource TextOnAccentBrush}" />
                                    <TextBlock Text="{loc:Loc settings.support.rial}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                               Foreground="{DynamicResource TextOnAccentBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Tag="https://donatr.ee/rkfcode/"
                                    Click="OnOpenLink"
                                    ToolTip="https://donatr.ee/rkfcode/">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="$" FontSize="15" VerticalAlignment="Center"
                                               FlowDirection="LeftToRight" />
                                    <TextBlock Text="{loc:Loc settings.support.intl}" VerticalAlignment="Center"
                                               Margin="6,0,0,0" Style="{StaticResource BodyText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- OPEN-SOURCE NOTE -->
                        <TextBlock Text="{loc:Loc settings.about.openSource}"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{loc:Loc action.cancel}" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="{loc:Loc action.save}" Style="{StaticResource PrimaryButton}"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
