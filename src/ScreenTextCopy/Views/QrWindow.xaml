<Window x:Class="ScreenTextCopy.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenTextCopy.Localization"
        Title="{loc:Loc mobile.title}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource BackgroundBrush}">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock Text="{loc:Loc mobile.title}" Style="{StaticResource TitleText}"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="{loc:Loc mobile.instruction}" Style="{StaticResource CaptionText}"
                       TextAlignment="Center" Margin="0,0,0,16" />

            <Border Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="260" Height="260"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" UseLayoutRounding="True" />
            </Border>

            <TextBlock x:Name="WarnText" Text="{loc:Loc mobile.tooLong}"
                       Style="{StaticResource CaptionText}"
                       Foreground="{DynamicResource WarningBrush}"
                       TextAlignment="Center" Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <Button Content="{loc:Loc action.close}" Style="{StaticResource SecondaryButton}"
                    Margin="0,16,0,0" HorizontalAlignment="Center"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
